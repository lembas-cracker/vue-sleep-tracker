---
import "../styles/global.css";

const description = "A simple sleep tracker built with Vue and Astro.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>SleeperAgent</title>
  </head>
  <body>
    <div
      class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-pink-50
            dark:from-slate-900 dark:via-slate-800 dark:to-indigo-950
            text-gray-800 dark:text-gray-100"
    >
      <slot />
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
