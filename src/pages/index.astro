---
import Layout from '../layouts/Layout.astro';
import {Icon} from 'astro-icon/components';
---

<Layout>
	 <div
		class="min-h-screen bg-white text-slate-900 font-sans selection:bg-indigo-100"
	>
		{/* nav */}
		<nav
			class="max-w-7xl mx-auto px-6 py-6 flex items-center justify-between"
		>
			<div class="flex items-center gap-2">
				<div class="p-3 bg-indigo-600 rounded-xl text-white">
					<a href="/"> <Icon name="lucide:cloud-moon" size={20} /></a>
				</div>
					<span class="text-xl font-bold tracking-tight">SleeperAgent</span>
			</div>
		</nav>

		{/* hero */}
		<header
			class="max-w-7xl mx-auto px-6 pt-16 pb-24 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center"
		>
			<div class="space-y-8 text-center lg:text-left">
				<div
					class="inline-flex items-center gap-2 px-3 py-1 bg-indigo-50 text-indigo-600 rounded-full text-sm font-medium"
				>
					<Icon name="lucide:moon" size={20} />
					<span>New: Visual Sleep Insights for Twins</span>
				</div>
				<h1
					class="text-5xl md:text-7xl font-extrabold text-slate-900 leading-[1.1]"
				>
					Half the guesswork, <br />
					<span class="text-indigo-600">double the data.</span>
				</h1>
				<p
					class="text-xl text-slate-500 max-w-xl mx-auto lg:mx-0 leading-relaxed"
				>
					 Track both babies simultaneously.
					 Analyze their unique cycles. Sync their schedules for a happier, well-rested household.
				</p>
				<div
					class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4"
				>
					<a
						href="/dashboard"
						class="w-full sm:w-auto px-8 py-4 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-2xl shadow-xl shadow-indigo-200 transition-all hover:-translate-y-1 flex items-center justify-center gap-2 text-lg"
					>
						Start Tracking Now <Icon
							name="lucide:arrow-right"
							size={20}
						/></a
					>
				</div>
				<div
					class="flex items-center justify-center lg:justify-start gap-4 text-sm text-slate-400 font-medium"
				>
					<div class="flex -space-x-2">
						{
							[1, 2, 3].map((i) => (
								<div
									class={`w-10 h-10 rounded-full border-2 border-white bg-slate-200 flex items-center justify-center text-[15px]`}
								>
									🧩
								</div>
							))
						}
					</div>
					<span>Trusted by parents</span>
				</div>
			</div>

			{/* Visual Element / Illustration Mockup */}
			<div class="relative">
				<div
					class="absolute inset-0 bg-indigo-100 rounded-[3rem] -rotate-3 blur-3xl opacity-30"
				>
				</div>
				<div
					class="relative bg-slate-50 border border-slate-200 rounded-[2.5rem] p-4 shadow-2xl"
				>
					<div
						class="bg-white rounded-[1.8rem] overflow-hidden shadow-inner p-6 space-y-6"
					>
						<div class="flex items-center justify-between">
							<div class="h-4 w-24 bg-slate-100 rounded-full">
							</div>
							<div class="h-8 w-8 bg-indigo-50 rounded-full">
							</div>
						</div>
						<div class="space-y-3">
							<div
								class="h-10 w-full bg-emerald-50 rounded-xl border border-emerald-100 flex items-center px-4"
							>
								<div
									class="h-3 w-3 rounded-full bg-emerald-400 mr-3"
								>
								</div>
								<div
									class="h-3 w-32 bg-emerald-200/50 rounded-full"
								>
								</div>
							</div>
							<div
								class="h-10 w-full bg-rose-50 rounded-xl border border-rose-100 flex items-center px-4"
							>
								<div
									class="h-3 w-3 rounded-full bg-rose-400 mr-3"
								>
								</div>
								<div
									class="h-3 w-24 bg-rose-200/50 rounded-full"
								>
								</div>
							</div>
						</div>
						<div class="pt-4 flex items-end gap-2 h-24">
							{
								[40, 70, 45, 90, 60].map((h, i) => (
									<div class="flex-1 space-y-1">
										<div
											style={{ height: `${h}%` }}
											class="w-full bg-indigo-100 rounded-t-lg"
										/>
										<div class="h-1.5 w-full bg-slate-100 rounded-full" />
									</div>
								))
							}
						</div>
					</div>
				</div>
			</div>
		</header>

		{/* Features Grid */}
		<section class="bg-slate-50 py-24">
			<div class="max-w-7xl mx-auto px-6">
				<div class="text-center mb-16">
					<h2 class="text-3xl font-bold text-slate-900 mb-4">
						Built for the Twin Chaos
					</h2>
					<p class="text-slate-500 max-w-2xl mx-auto">
						Your Sanity Saver for Twin Parenting.
					</p>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					{
						[
							{
								icon: (
									<Icon
										name="lucide:zap"
										size="20"
										class="text-amber-500"
									/>
								),
								title: "One-Tap Logging",
								desc: "Designed for tired eyes. Log a nap in under 5 seconds with pre-set child profiles.",
							},
							{
								icon: (
									<Icon
										name="lucide:bar-chart-3"
										size="20"
										class="text-indigo-500"
									/>
								),
								title: "Visual Comparison",
								desc: "Instantly see if your twins are syncing their schedules with side-by-side charts.",
							},
							{
								icon: (
									<Icon
										name="lucide:shield-check"
										size="20"
										class="text-emerald-500"
									/>
								),
								title: "Safe & Local",
								desc: "Your data stays in your browser. No account needed to start tracking immediately.",
							},
						].map((feature, i) => (
							<div class="bg-white p-8 rounded-3xl border border-slate-100 shadow-sm hover:shadow-md transition-shadow">
								<div class="p-3 bg-slate-50 inline-block rounded-2xl mb-6">
									{feature.icon}
								</div>
								<h3 class="text-xl font-bold mb-3">
									{feature.title}
								</h3>
								<p class="text-slate-500 leading-relaxed">
									{feature.desc}
								</p>
							</div>
						))
					}
				</div>
			</div>
		</section>
	</div>
</Layout>
