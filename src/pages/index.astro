---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<script>
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => e.isIntersecting && e.target.classList.add("revealed")),
    { threshold: 0.15 },
  );
  document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

  const card = document.querySelector<HTMLElement>("[data-tilt]");
  if (card)
    window.addEventListener("mousemove", (e) => {
      const { innerWidth: w, innerHeight: h } = window;
      const x = (e.clientX / w - 0.5) * 10;
      const y = (e.clientY / h - 0.5) * -10;
      card.style.transform = `perspective(1000px) rotateY(${x}deg) rotateX(${y}deg)`;
      card.style.transition = "transform 0.2s ease-out";
    });
</script>

<Layout>
  <div
    class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-pink-50
              dark:from-slate-900 dark:via-slate-800 dark:to-indigo-950
              text-slate-900 dark:text-slate-100 font-sans
              selection:bg-indigo-100 dark:selection:bg-indigo-500/30"
  >
    {/* nav */}
    <nav class="max-w-7xl mx-auto px-6 py-6 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div
          class="p-3 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-xl text-white
                    shadow-lg shadow-indigo-500/30"
        >
          <a href="/"> <Icon name="lucide:cloud-moon" size={20} /></a>
        </div>
        <span class="text-xl font-bold tracking-tight text-slate-800 dark:text-slate-100"> SleeperAgent </span>
      </div>
    </nav>

    {/* hero */}
    <header class="max-w-7xl mx-auto px-6 pt-16 pb-24 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="space-y-8 text-center lg:text-left">
        <div
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-sm font-medium
                 bg-white/70 dark:bg-slate-800/60
                 backdrop-blur-xl
                 ring-1 ring-white/60 dark:ring-white/10
                 text-indigo-600 dark:text-indigo-300
                 shadow-[0_8px_30px_rgb(0,0,0,0.06)]"
        >
          <Icon name="lucide:moon" size={20} />
          <span>New: Visual Sleep Insights for Twins</span>
        </div>

        <h1 class="text-5xl md:text-7xl font-extrabold text-slate-900 dark:text-slate-100 leading-[1.1]">
          Half the guesswork, <br />
          <span
            class="bg-gradient-to-r from-indigo-500 to-purple-500
                       bg-clip-text text-transparent"
          >
            double the data.
          </span>
        </h1>

        <p class="text-xl text-slate-500 dark:text-slate-400 max-w-xl mx-auto lg:mx-0 leading-relaxed">
          Track both babies simultaneously. Analyze their unique cycles. Sync their schedules for a happier, well-rested
          household.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a
            href="/dashboard"
            class="group relative w-full sm:w-auto overflow-hidden
                   px-8 py-4 rounded-2xl
                   bg-gradient-to-r from-blue-500 to-indigo-600
                   text-white font-bold text-lg
                   shadow-xl shadow-blue-500/30
                   transition-all duration-200
                   hover:-translate-y-1 hover:shadow-blue-500/50
                   flex items-center justify-center gap-2"
          >
            <span class="relative z-10 flex items-center gap-2">
              Start Tracking Now <Icon name="lucide:arrow-right" size={20} />
            </span>
            <span
              class="pointer-events-none absolute inset-0 -translate-x-full
                     bg-gradient-to-r from-transparent via-white/30 to-transparent
                     transition-transform duration-700
                     group-hover:translate-x-full"
              aria-hidden="true"></span>
          </a>
        </div>

        <div
          class="flex items-center justify-center lg:justify-start gap-4 text-sm
                    text-slate-500 dark:text-slate-400 font-medium"
        >
          <div class="flex -space-x-2">
            {
              [1, 2, 3].map((i) => (
                <div
                  class={`w-10 h-10 rounded-full border-2
                          border-white dark:border-slate-800
                          bg-white/70 dark:bg-slate-700/60
                          backdrop-blur-xl
                          flex items-center justify-center text-[15px]`}
                >
                  🧩
                </div>
              ))
            }
          </div>
          <span>Trusted by parents</span>
        </div>
        <div
          class="flex items-center justify-center lg:justify-start text-md
                    text-slate-500 dark:text-slate-400 font-semibold"
        >
          <a
            href="https://github.com/lembas-cracker/vue-sleep-tracker"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-lg p-2
         text-slate-400 transition-colors duration-150
         hover:bg-slate-100 hover:text-slate-900
         dark:text-slate-400 dark:hover:bg-slate-700/60 dark:hover:text-slate-100
         focus:outline-none focus-visible:ring-4 focus-visible:ring-blue-200"
          >
            <span class="flex items-center gap-2">
              <Icon name="lucide:github" size={22} />
              Ksenia's github source code</span
            >
          </a>
        </div>
      </div>

      {/* illustration mockup */}
      <div class="relative" data-tilt>
        <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden sm:overflow-visible">
          <div class="absolute -top-16 -left-16 h-96 w-96 rounded-full
             bg-indigo-400/20 blur-3xl"></div>
          <div class="absolute -bottom-16 -right-16 h-96 w-96 rounded-full
             bg-purple-400/20 blur-3xl"></div>
        </div>
        {/* glow behind the mockup */}
        <div
          class="absolute inset-16 bg-gradient-to-br from-indigo-300 to-purple-300
            dark:from-indigo-500/15 dark:to-purple-500/15
            rounded-[3rem] -rotate-3 blur-xl opacity-10"
        >
        </div>

        <div
          class="relative rounded-[2.5rem] p-4
              bg-white/70 dark:bg-slate-800/60
              backdrop-blur-xl
              ring-1 ring-white/60 dark:ring-white/10
              shadow-[0_8px_30px_rgb(0,0,0,0.06)]"
        >
          <div
            class="rounded-[1.8rem] overflow-hidden p-6 space-y-6
                      bg-white/60 dark:bg-slate-900/50
                      backdrop-blur-xl
                      ring-1 ring-white/60 dark:ring-white/10
                      shadow-inner"
          >
            <div class="flex items-center justify-between">
              <div class="h-4 w-24 rounded-full bg-slate-200/80 dark:bg-slate-700/60"></div>
              <div class="h-8 w-8 rounded-full bg-indigo-100 dark:bg-indigo-500/20"></div>
            </div>
            <div class="space-y-3">
              <div
                class="h-10 w-full rounded-xl flex items-center px-4
                          bg-emerald-50 dark:bg-emerald-500/10
                          border border-emerald-100 dark:border-emerald-500/20"
              >
                <div class="h-3 w-3 rounded-full bg-emerald-400 mr-3"></div>
                <div class="h-3 w-32 rounded-full bg-emerald-200/50 dark:bg-emerald-400/30"></div>
              </div>
              <div
                class="h-10 w-full rounded-xl flex items-center px-4
                          bg-rose-50 dark:bg-rose-500/10
                          border border-rose-100 dark:border-rose-500/20"
              >
                <div class="h-3 w-3 rounded-full bg-rose-400 mr-3"></div>
                <div class="h-3 w-24 rounded-full bg-rose-200/50 dark:bg-rose-400/30"></div>
              </div>
            </div>
            <div class="pt-4 flex items-end gap-2 h-24">
              {
                [40, 70, 45, 90, 60].map((h, i) => (
                  <div class="flex-1 space-y-1">
                    <div
                      style={{ height: `${h}%` }}
                      class="w-full rounded-t-lg bg-gradient-to-t
                             from-indigo-500 to-purple-500
                             dark:from-indigo-400 dark:to-purple-400"
                    />
                    <div class="h-1.5 w-full rounded-full bg-slate-200/80 dark:bg-slate-700/60" />
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </header>

    {/* features */}
    <section class="py-16 sm:py-24">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold text-slate-900 dark:text-slate-100 mb-4">Built for the Twin Chaos</h2>
          <p class="text-slate-500 dark:text-slate-400 max-w-2xl mx-auto">Your Sanity Saver for Twin Parenting.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {
            [
              {
                icon: <Icon name="lucide:zap" size="20" class="text-amber-500 dark:text-amber-400" />,
                title: "One-Tap Logging",
                desc: "Designed for tired eyes. Log a nap in under 5 seconds with pre-set child profiles.",
              },
              {
                icon: <Icon name="lucide:bar-chart-3" size="20" class="text-indigo-500 dark:text-indigo-400" />,
                title: "Visual Comparison",
                desc: "Instantly see if your twins are syncing their schedules with side-by-side charts.",
              },
              {
                icon: <Icon name="lucide:shield-check" size="20" class="text-emerald-500 dark:text-emerald-400" />,
                title: "Safe & Local",
                desc: "Your data stays in your browser. No account needed to start tracking immediately.",
              },
            ].map((feature, i) => (
              <div
                class="reveal rounded-2xl p-8
                       bg-white/70 dark:bg-slate-800/60
                       backdrop-blur-xl
                       ring-1 ring-white/60 dark:ring-white/10
                       shadow-[0_8px_30px_rgb(0,0,0,0.06)]
                       transition-all duration-300
                       hover:shadow-[0_8px_40px_rgb(99,102,241,0.15)]
                       hover:-translate-y-0.5"
                style={`transition-delay: ${i * 80}ms;`}
              >
                <div
                  class="p-3 inline-block rounded-2xl mb-6
                            bg-white/60 dark:bg-slate-700/60
                            ring-1 ring-white/60 dark:ring-white/10"
                >
                  {feature.icon}
                </div>
                <h3 class="text-xl font-bold mb-3 text-slate-800 dark:text-slate-100">{feature.title}</h3>
                <p class="text-slate-500 dark:text-slate-400 leading-relaxed">{feature.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</Layout>
