---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <div
        class="min-h-screen bg-slate-50 flex items-center justify-center p-6 text-center"
    >
        <div class="max-w-md mx-auto">
            <div class="relative mb-12 inline-block">
    <div
        class="absolute inset-0 bg-indigo-200 rounded-full blur-2xl opacity-40 animate-pulse"
    >
    </div>
    <div
        class="relative bg-white p-8 rounded-full shadow-xl border border-indigo-50"
    >
        <Icon
            name="lucide:moon"
            size={64}
            class="text-indigo-500 animate-bounce"
        />
    </div>
    <div
        class="absolute top-2 right-2 z-10 bg-rose-400 text-white text-xs font-bold px-3 py-1 rounded-full shadow-lg"
    >
        Zzz...
    </div>
</div>
          <div class="mb-12">
            <h1 class="text-3xl font-bold text-slate-900 mb-3">404</h1>
            <h2 class="text-2xl font-bold text-slate-700 mb-5">
                The nap was interrupted!
            </h2>
            <p class="text-slate-500 leading-relaxed">
                It looks like this page is currently sleeping or doesn't exist.
                Let's get you back to the nursery.
            </p>
          </div>

            <div class="flex flex-col gap-3">
                <a
                    href="/dashboard"
                    class="w-full py-4 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-2xl shadow-lg shadow-indigo-100 transition-all flex items-center justify-center gap-2"
                >
                    <Icon name="lucide:layout-dashboard" size={20} /> Back to Dashboard
                </a>
                <a
                    href="/"
                    class="w-full py-4 bg-white border border-slate-200 hover:bg-slate-50 text-slate-600 font-semibold rounded-2xl transition-all"
                >
                    Go to Home Page
                </a>
            </div>

            <div
                class="mt-12 flex items-center justify-center gap-2 text-slate-400 text-sm"
            >
                <Icon name="lucide:search" size={14} />
                <span>Looking for something else? Contact support</span>
            </div>
        </div>
    </div>
</Layout>