---
import Layout from "../layouts/Layout.astro";
import NapForm from "../components/NapForm.vue";
import NapChart from "../components/NapChart.vue";
import NapList from "../components/NapList.vue";
---

<Layout>
  <div class="min-h-screen py-6 px-4 sm:py-10 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <!-- Page Title -->
      <h1 class="text-center text-3xl font-extrabold text-gray-800 sm:text-4xl lg:text-left">Dashboard</h1>

      <!-- Main Grid -->
      <div class="mt-6 grid grid-cols-1 gap-6 sm:mt-10 lg:grid-cols-3 lg:gap-8">
        <!-- Nap Form Card -->
        <div class="lg:col-span-1">
          <div class="rounded-xl bg-white p-5 shadow-md sm:p-6">
            <NapForm client:load />
          </div>
        </div>

        <!-- Right Column: Chart + List -->
        <div class="flex flex-col gap-6 lg:col-span-2 lg:gap-8">
          <!-- Nap Chart Card -->
          <div class="rounded-xl bg-white p-5 shadow-md sm:p-6">
            <NapChart client:load />
          </div>

          <!-- Nap List Card -->
          <div class="rounded-xl bg-white p-5 shadow-md sm:p-6">
            <NapList client:load />
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
